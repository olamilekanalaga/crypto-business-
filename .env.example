# Python CLI reads process variables; export them or use: set -a; source .env.local; set +a
TERMINAL_DATA_DIR=./data
PYTHON_BIN=python3
COINGECKO_DEMO_API_KEY=
COINGECKO_REQUEST_INTERVAL=7
# Set both together for the paid Pro API (optional, never required).
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
COINGECKO_PRO_API_KEY=

# Optional private hosted network. Never use NEXT_PUBLIC for these values.
# Run postgres/001_network.sql before connecting the hosted store.
DATABASE_URL=
# Generate a random value of at least 32 characters. Enter it only in your app's
# private server connection field. Do not paste it in chat or commit it.
BDO_OWNER_TOKEN=
# AI is opt-in. Browser matching works without any model/API key.
BDO_AI_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=
